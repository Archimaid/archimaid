---
import Community from '../components/Community.astro';
import Connectors from '../components/Connectors.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LayerStripe from '../components/LayerStripe.astro';
import Notation from '../components/Notation.astro';
import Base from '../layouts/Base.astro';
import { project } from '../lib/project';

const title = `${project.name}: ArchiMate® diagrams as text, rendered by Mermaid`;
const description =
  'Write ArchiMate® 3.2 diagrams in plain text, validate them in CI, and render them wherever Mermaid runs. Open source and MIT-licensed.';

const site = Astro.site;
if (!site) throw new Error('Set `site` in astro.config.mjs for canonical URLs and structured data.');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('#website', site).href,
      url: site.href,
      name: project.name,
      description,
      inLanguage: 'en-GB',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': new URL('#software', site).href,
      name: project.name,
      description,
      url: site.href,
      image: new URL('/og.png', site).href,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      softwareVersion: project.version,
      license: `https://spdx.org/licenses/${project.licenseId}.html`,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      sameAs: [project.repository, project.npm],
    },
  ],
};
---

<Base title={title} description={description} structuredData={structuredData}>
  <LayerStripe />
  <Header />
  <main>
    <Hero />
    <HowItWorks />
    <Features />
    <Connectors />
    <Notation />
    <Community />
  </main>
  <Footer />
</Base>
