archimate-beta
  layout framework
  accTitle: Order fulfilment
  accDescr: A customer order, from process to platform.

  element requirement ship "Ship within 24h"
  element businessActor customer "Customer"
  element businessProcess fulfil "Fulfil order"
  element applicationService api "Order API"
  element applicationComponent oms "Order service"
  element dataObject order "Order"
  element technologyService hosting "Hosting"
  element node cluster "Kubernetes"

  fulfil ..|> ship
  customer @==> fulfil
  api --> fulfil
  oms ..|> api
  oms ..> order
  hosting --> oms
  cluster ..|> hosting

  note sla "Measured from payment\nto dispatch" on ship
