---
import diagramSvg from '../diagrams/order-fulfilment.svg?raw';
import diagramSource from '../diagrams/order-fulfilment.mmd?raw';
import { playgroundLink } from '../lib/playground';
import CompareSlider from './CompareSlider.astro';
import FloatingElements from './FloatingElements.astro';
import InstallCommand from './InstallCommand.astro';

const editLink = playgroundLink(diagramSource);
const lineCount = diagramSource.trimEnd().split('\n').length;
const description =
  'Framework layout of an order fulfilment diagram. The Customer is assigned to Fulfil order, which realizes the requirement Ship within 24h, noted as measured from payment to dispatch. The Order API serves Fulfil order and is realized by the Order service, which writes the Order data object. Hosting serves the Order service and is realized by the Kubernetes node.';
---

<section id="top" class="container hero">
  <FloatingElements />

  <div class="intro">
    <ul class="tags" aria-label="About Archimaid">
      <li>Open source · MIT</li>
      <li style="background: var(--implementation)">Mermaid plugin</li>
      <li style="background: var(--motivation)">ArchiMate® 3.2</li>
    </ul>
    <h1>Write the architecture. <mark>Get&nbsp;the&nbsp;diagram.</mark></h1>
    <p class="lede">
      Archimaid adds ArchiMate® 3.2 to Mermaid. Describe elements and relationships in plain text, check them in CI,
      and render them wherever Mermaid runs.
    </p>
    <div class="actions">
      <a class="button" href={editLink} style="background: var(--application)">
        Try it in your browser
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
      <InstallCommand />
    </div>
  </div>

  <CompareSlider fileName="order-fulfilment.mmd" source={diagramSource} svg={diagramSvg} description={description} />

  <p class="hint">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5"></path></svg
    >
    <span>
      Drag the handle: {lineCount} lines of text on one side, the diagram they draw on the other.
      <a href={editLink}>Edit this diagram in the playground</a>
    </span>
  </p>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 40px;
  }

  .intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    font-weight: 600;
  }

  .tags li {
    padding: 6px 12px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--white);
  }

  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  mark {
    padding: 0 0.18em;
    border-radius: 0.18em;
    background: var(--business);
    color: inherit;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .lede {
    max-width: 640px;
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
  }

  .hint {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--ink-muted);
    text-align: center;
  }

</style>
