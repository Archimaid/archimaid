---
import { validateArchiMate } from 'archimaid/language';
import { playgroundLink } from '../lib/playground';
import { project } from '../lib/project';

interface Example {
  readonly fileName: string;
  readonly title: string;
  readonly elementCount: number;
  readonly link: string;
}

const sources = import.meta.glob<string>('../../../examples/*.mmd', { query: '?raw', import: 'default', eager: true });

const examples: readonly Example[] = Object.entries(sources)
  .map(([path, source]) => {
    const fileName = path.slice(path.lastIndexOf('/') + 1);
    const { model } = validateArchiMate(source);
    if (!model) throw new Error(`The packaged example ${fileName} no longer parses; fix it before linking to it.`);
    const title = model.title ?? model.accTitle;
    if (!title) throw new Error(`The packaged example ${fileName} needs a title or accTitle to be listed.`);
    return { fileName, title, elementCount: model.elements.length, link: playgroundLink(source) };
  })
  .sort((left, right) => left.elementCount - right.elementCount);

const playgroundHost = new URL(project.playground).host;

const capabilities = [
  {
    layer: 'business',
    title: 'Write',
    text: 'The diagram redraws as you type. Errors are underlined in place, with the keyword you probably meant.',
  },
  {
    layer: 'application',
    title: 'Share',
    text: 'Copy a link that carries the whole diagram. No account, and nothing is stored on a server.',
  },
  {
    layer: 'technology',
    title: 'Export',
    text: 'Download an SVG or PNG for slides, wikis and design documents, in a light or dark theme.',
  },
] as const;
---

<section id="playground" class="container section">
  <div class="layout">
    <div class="pitch">
      <div class="section-heading" data-reveal>
        <span class="eyebrow">Playground</span>
        <h2>Draw one now. Install nothing.</h2>
        <p>
          The playground runs the same renderer in your browser. Your diagram stays on your machine until you choose to
          share it.
        </p>
      </div>
      <ul class="capabilities">
        {
          capabilities.map((capability) => (
            <li style={`--accent: var(--${capability.layer}); --accent-stroke: var(--${capability.layer}-stroke)`}>
              <h3>{capability.title}</h3>
              <p>{capability.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="launcher" data-reveal style="--reveal-delay: 120ms">
      <a class="button open" href={project.playground}>
        Open {playgroundHost}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg
        >
      </a>
      <p class="launcher-note">Opens your last diagram, or a starter if this is your first visit.</p>
      <h3 id="examples-heading">Or start from an example</h3>
      <ul class="examples" aria-labelledby="examples-heading">
        {
          examples.map((example) => (
            <li>
              <a href={example.link}>
                <span class="example-title">{example.title}</span>
                <span class="example-meta">
                  <code>{example.fileName}</code>
                  <span>{example.elementCount} elements</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr));
    gap: 56px;
    align-items: start;
  }

  .pitch {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .capabilities {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capabilities li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 20px;
    border-left: 6px solid var(--accent);
    box-shadow: inset 1.5px 0 0 var(--accent-stroke);
  }

  .capabilities h3 {
    margin: 0;
    font-size: 21px;
    letter-spacing: -0.02em;
  }

  .capabilities p {
    max-width: 52ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .launcher {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: 2px solid var(--ink);
    border-radius: 20px;
    background: var(--white);
    box-shadow: 8px 8px 0 var(--application);
  }

  .open {
    align-self: flex-start;
    background: var(--application);
  }

  .launcher-note {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .launcher h3 {
    margin: 18px 0 0;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .examples {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .examples li {
    border-bottom: 1.5px solid var(--ink);
  }

  .examples a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 4px;
    text-decoration: none;
  }

  .examples a:hover .example-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .example-title {
    font-size: 16px;
    font-weight: 600;
  }

  .example-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    white-space: nowrap;
    font-size: 13px;
    color: var(--ink-muted);
  }

  .example-meta code {
    font-size: 12px;
  }
</style>
