---
import type { ElementType } from 'archimaid/language';
import ElementShape from './ElementShape.astro';

interface FloatingElement {
  readonly type: ElementType;
  readonly side: 'left' | 'right';
  readonly inset: number;
  readonly top: number;
  readonly width: number;
  readonly height: number;
  readonly tilt: number;
  readonly depth: number;
  readonly duration: number;
  readonly delay: number;
}

const elements: readonly FloatingElement[] = [
  { type: 'businessProcess', side: 'left', inset: 8, top: 40, width: 132, height: 56, tilt: -9, depth: 0.35, duration: 7, delay: 0 },
  { type: 'requirement', side: 'left', inset: 128, top: 150, width: 104, height: 50, tilt: 7, depth: 0.15, duration: 9, delay: -2 },
  { type: 'capability', side: 'left', inset: 20, top: 248, width: 96, height: 46, tilt: -4, depth: 0.5, duration: 8, delay: -5 },
  { type: 'workPackage', side: 'left', inset: 116, top: 330, width: 112, height: 48, tilt: 10, depth: 0.25, duration: 10, delay: -1 },
  { type: 'applicationService', side: 'right', inset: 24, top: 36, width: 120, height: 54, tilt: 8, depth: 0.3, duration: 8, delay: -3 },
  { type: 'goal', side: 'right', inset: 150, top: 132, width: 92, height: 46, tilt: -8, depth: 0.55, duration: 7.5, delay: -4 },
  { type: 'node', side: 'right', inset: 40, top: 220, width: 118, height: 58, tilt: -6, depth: 0.2, duration: 9.5, delay: -6 },
  { type: 'dataObject', side: 'right', inset: 140, top: 320, width: 100, height: 48, tilt: 5, depth: 0.4, duration: 8.5, delay: -2.5 },
];
---

<div class="floating" aria-hidden="true" data-floating>
  {
    elements.map((element) => (
      <div
        class="parallax"
        style={`${element.side}: ${element.inset}px; top: ${element.top}px; --depth: ${element.depth}`}
      >
        <div
          class="bob"
          style={`--tilt: ${element.tilt}deg; --duration: ${element.duration}s; --delay: ${element.delay}s`}
        >
          <ElementShape type={element.type} width={element.width} height={element.height} outlineColor="var(--ink)" />
        </div>
      </div>
    ))
  }
</div>

<script>
  const container = document.querySelector<HTMLElement>('[data-floating]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (container) {
    let visible = true;
    let frame = 0;

    const update = (): void => {
      frame = 0;
      container.style.setProperty('--scroll', String(reducedMotion.matches ? 0 : window.scrollY));
    };
    const schedule = (): void => {
      if (visible && frame === 0) frame = requestAnimationFrame(update);
    };

    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      schedule();
    }).observe(container);
    window.addEventListener('scroll', schedule, { passive: true });
    reducedMotion.addEventListener('change', schedule);
    update();
  }
</script>

<style>
  .floating {
    --scroll: 0;
    position: absolute;
    inset: 0 0 auto;
    height: 420px;
    pointer-events: none;
  }

  .parallax {
    position: absolute;
    line-height: 0;
    transform: translate3d(0, calc(var(--scroll) * var(--depth) * -1px), 0);
    will-change: transform;
  }

  .bob {
    transform: rotate(var(--tilt));
    animation: bob var(--duration) ease-in-out var(--delay) infinite alternate;
  }

  @keyframes bob {
    from {
      transform: translateY(-7px) rotate(calc(var(--tilt) - 3deg));
    }
    to {
      transform: translateY(7px) rotate(calc(var(--tilt) + 3deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bob {
      animation: none;
    }
  }

  @media (max-width: 1100px) {
    .floating {
      display: none;
    }
  }
</style>
