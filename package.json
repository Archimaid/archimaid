{
  "name": "archimaid",
  "version": "0.1.0",
  "description": "ArchiMate for Mermaid: write, validate and render ArchiMate 3.2 diagrams as an external Mermaid diagram type",
  "keywords": [
    "archimate",
    "archimate-3",
    "mermaid",
    "mermaid-plugin",
    "mermaid-diagram",
    "enterprise-architecture",
    "architecture-diagrams",
    "diagrams-as-code"
  ],
  "license": "MIT",
  "author": "Berny (https://github.com/Berny-art)",
  "homepage": "https://archimaid.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Archimaid/archimaid.git"
  },
  "bugs": {
    "url": "https://github.com/Archimaid/archimaid/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/",
    "examples/*.mmd",
    "examples/*.svg",
    "skills/archimaid/SKILL.md",
    "docs/reference.md",
    "FOUNDATION.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "import": "./dist/language.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle/archimaid.esm.min.mjs"
    }
  },
  "bin": {
    "archimaid": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node --test test/browser/*.test.mjs",
    "render": "npm run build --silent && node dist/cli.js render",
    "render:preview": "npm run build --silent && node scripts/render-element-preview.mjs",
    "reference": "npm run build --silent && node scripts/generate-reference.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "mermaid": "^12.3.0",
    "playwright": "^1.56.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "chevrotain": "13.2.0",
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "mermaid": "12.3.0",
    "playwright": "1.65.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
